@@ -567,7 +614,9 @@ def seg_select_tokens(qi: torch.Tensor, wts: torch.Tensor, pk: torch.Tensor, row
                                                                                                           torch.Tensor]:
     """select_tokens for a segmented window: each sparse row's attended tokens [R, 2051] (relative to its stream,
