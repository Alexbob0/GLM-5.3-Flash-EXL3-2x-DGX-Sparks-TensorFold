+    def _owe(self, seconds: float) -> None:
+        """Rank 0, after a prompt chunk that ran while others decode under TF_GLM_FILL_TIME: the rounds owed for it
+        (capped, so one huge chunk cannot hold the next prompt chunk back for long)."""
