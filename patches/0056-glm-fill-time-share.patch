+def fill_time(value: str | None = None) -> float | None:
+    """TF_GLM_FILL_TIME: the share of GPU time prompt chunks take while other streams decode, or None (unset: the
+    iteration share of TF_GLM_FILL_SHARE). A prompt chunk deep in a long prompt takes ~15x a decode round, so one
+    chunk a round leaves the decoding streams a few percent of the time; with a time share, the rounds after a chunk
+    run until the decoding streams had their share of its time."""
+
+    value = os.environ.get("TF_GLM_FILL_TIME", "") if value is None else value
+    if value.strip() == "":
+        return None
+    try:
+        share = float(value)
+    except ValueError:
+        share = -1.0
+    if not 0 < share < 1:
+        raise ValueError(f"TF_GLM_FILL_TIME: a share above 0 and below 1, not {value!r}")
+    return share
+
+
 def fill_share(value: str | None = None) -> float:
     """TF_GLM_FILL_SHARE: the share of iterations prompt chunks take while other streams decode (default 0.5: a
     chunk, a round, a chunk, ...); 1 fills every prompt before decoding on."""
